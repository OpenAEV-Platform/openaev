<configuration>
    <!-- Prefer new Spring keys, but keep legacy AUDIT_LOG_* overrides for compatibility -->
    <springProperty scope="context" name="AUDIT_LOG_DIR_PROPERTIES" source="openaev.audit-logs.file.dir" />
    <springProperty scope="context" name="AUDIT_LOG_FILENAME_PROPERTIES" source="openaev.audit-logs.file.filename" />
    <springProperty scope="context" name="AUDIT_LOG_DIR_ENV_VARIABLE" source="AUDIT_LOG_DIR" />
    <springProperty scope="context" name="AUDIT_LOG_FILENAME_ENV_VARIABLE" source="AUDIT_LOG_FILENAME" />
    <springProperty scope="context" name="AUDIT_LOG_ROLLOVER_MAX_SIZE" source="openaev.audit-logs.file.rollover-max-size" defaultValue="100MB" />
    <springProperty scope="context" name="AUDIT_LOG_RETENTION_DAYS" source="openaev.audit-logs.file.retention-days" defaultValue="90" />
    <springProperty scope="context" name="AUDIT_LOG_ROLLOVER_TOTAL_SIZE_CAP" source="openaev.audit-logs.file.rollover-total-size-cap" defaultValue="20GB" />
    <property name="AUDIT_LOG_DIR" value="${AUDIT_LOG_DIR_PROPERTIES:-${AUDIT_LOG_DIR_ENV_VARIABLE:-logs}}" />
    <property name="AUDIT_LOG_FILENAME" value="${AUDIT_LOG_FILENAME_PROPERTIES:-${AUDIT_LOG_FILENAME_ENV_VARIABLE:-audit.log}}" />
    <property name="AUDIT_LOG_FILE" value="${AUDIT_LOG_DIR}/${AUDIT_LOG_FILENAME}" />

    <springProfile name="dev | test">
        <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <!-- Audit log file appender with daily rolling -->
        <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${AUDIT_LOG_FILE}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${AUDIT_LOG_DIR}/${AUDIT_LOG_FILENAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${AUDIT_LOG_ROLLOVER_MAX_SIZE}</maxFileSize>
                <maxHistory>${AUDIT_LOG_RETENTION_DAYS}</maxHistory>
                <totalSizeCap>${AUDIT_LOG_ROLLOVER_TOTAL_SIZE_CAP}</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %msg%n</pattern>
            </encoder>
        </appender>

        <!-- Audit log: file only in dev (console output handled by AuditConsoleLogTransportUtils) -->
        <logger name="AUDIT_LOG" level="INFO" additivity="false">
            <appender-ref ref="AUDIT_FILE" />
        </logger>

        <root>
            <appender-ref ref="STDOUT" />
        </root>
    </springProfile>
    <springProfile name="!(dev | test)">
        <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
        <appender name="jsonEncoder" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="io.openaev.logging.StackDepthLimitingJsonEncoder">
                <!-- values are already resolved into "message" -->
                <withArguments>false</withArguments>
                <withThrowable>true</withThrowable>
                <maxStackDepth>80</maxStackDepth>
            </encoder>
        </appender>

        <!-- Audit log file appender with daily rolling (JSON format) -->
        <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${AUDIT_LOG_FILE}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${AUDIT_LOG_DIR}/${AUDIT_LOG_FILENAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${AUDIT_LOG_ROLLOVER_MAX_SIZE}</maxFileSize>
                <maxHistory>${AUDIT_LOG_RETENTION_DAYS}</maxHistory>
                <totalSizeCap>${AUDIT_LOG_ROLLOVER_TOTAL_SIZE_CAP}</totalSizeCap>
            </rollingPolicy>
            <encoder class="io.openaev.logging.StackDepthLimitingJsonEncoder">
                <!-- values are already resolved into "message" -->
                <withArguments>false</withArguments>
                <withThrowable>true</withThrowable>
                <maxStackDepth>80</maxStackDepth>
            </encoder>
        </appender>

        <!-- Audit log: console (JSON) + file (JSON), independent of root level -->
        <logger name="AUDIT_LOG" level="INFO" additivity="false">
            <appender-ref ref="jsonEncoder" />
            <appender-ref ref="AUDIT_FILE" />
        </logger>

        <root>
            <appender-ref ref="jsonEncoder" />
        </root>
    </springProfile>
</configuration>