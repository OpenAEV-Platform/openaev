# SAML2 SSO against Mock SAML (https://mocksaml.com), to test the login flow locally.
# Copy to application-saml.properties, then activate with --spring.profiles.active=dev,saml
#
# Log in on http://localhost:8080/saml2/authenticate/mocksaml with any @example.com or
# @example.org address and any password: Mock SAML answers 403 for every other domain.
#
# Offline: docker run -p 4000:4000 boxyhq/mock-saml, then point metadata-uri at
# http://localhost:4000/api/saml/metadata

openaev.auth-saml2-enable=true

spring.security.saml2.relyingparty.registration.mocksaml.assertingparty.metadata-uri=https://mocksaml.com/api/saml/metadata

# Mock SAML releases id, email, firstName and lastName; the NameID carries the email.
openaev.provider.mocksaml.firstname_attribute_key=firstName
openaev.provider.mocksaml.lastname_attribute_key=lastName
