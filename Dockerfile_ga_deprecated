FROM amazoncorretto:21-alpine3.24 AS app

# Fixed world-readable browser path so any runtime UID finds the Chromium bundle (reporting)
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /opt
RUN set -eux; \
    apk add --no-cache tini git \
        nss freetype harfbuzz ca-certificates ttf-freefont udev; \
    update-ca-certificates
COPY openaev-build ./
# Install Chromium for server-side report rendering. On Alpine, Playwright's
# "--with-deps" is not apt-compatible, so system libraries are installed via apk above.
# The boot jar uses the ZIP layout, so PropertiesLauncher can run the embedded Playwright CLI.
RUN set -eux; \
    java -Dloader.main=com.microsoft.playwright.CLI -jar openaev-api.jar install chromium; \
    chmod -R a+rX /ms-playwright

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["java", "-jar", "openaev-api.jar"]
