FROM amazoncorretto:21-alpine3.24 AS app

# Fixed world-readable browser path so any runtime UID finds the Chromium bundle (reporting)
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV CHROME_BIN=/usr/bin/chromium
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /opt
RUN set -eux; \
    apk add --no-cache tini git \
        chromium nss freetype harfbuzz ca-certificates ttf-freefont udev; \
    update-ca-certificates
COPY openaev-build ./
# Alpine uses musl libc: Playwright browser download/install can fail in this image.
# Use distro Chromium instead and keep /ms-playwright readable if created at runtime.
RUN set -eux; \
    mkdir -p /ms-playwright; \
    chmod -R a+rX /ms-playwright

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["java", "-jar", "openaev-api.jar"]
