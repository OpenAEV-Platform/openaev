# OpenAEV — Core CI + Nightly CI pipeline
#
#   d2 --layout elk --pad 60 ci-pipeline-schema.d2 ci-pipeline-schema.svg
#   d2 --watch ci-pipeline-schema.d2          # live preview while editing
#
# Organised by TIME, not by function: the point of this pipeline is that almost
# nothing waits. 12 of the 16 job definitions launch at t=0 and pull what they
# need by polling; only 4 use `needs:`.
#
# Fan-in/fan-out is drawn lane-to-lane rather than job-to-job on purpose — the
# Gate really has 14 `needs:`, but 14 arrows converging on one box is unreadable.

direction: down

classes: {
preflight: {style: {fill: "#FFFDE7"; stroke: "#F9A825"; stroke-width: 2 ; border-radius: 8; font-size: 19}}
build: {style: {fill: "#E3F2FD"; stroke: "#1565C0"; stroke-width: 2     ; border-radius: 8; font-size: 19}}
quality: {style: {fill: "#F3E5F5"; stroke: "#6A1B9A"; stroke-width: 2   ; border-radius: 8; font-size: 19}}
test: {style: {fill: "#E8F5E9"; stroke: "#2E7D32"; stroke-width: 2      ; border-radius: 8; font-size: 19}}
docker: {style: {fill: "#FFF3E0"; stroke: "#EF6C00"; stroke-width: 2    ; border-radius: 8; font-size: 19}}
lane: {style: {fill: "#FFFFFF"; stroke: "#B0BEC5"; stroke-width: 2      ; font-size: 21; bold: true}}

needs: {style: {stroke: "#37474F"; stroke-width: 3  ; font-size: 18}}
launch: {style: {stroke: "#78909C"; stroke-width: 3 ; stroke-dash: 2; font-size: 20; bold: true}}
poll: {style: {stroke: "#EF6C00"; stroke-width: 3   ; stroke-dash: 5; font-size: 17; italic: true; bold: true}}
loop: {style: {stroke: "#4527A0"; stroke-width: 3   ; stroke-dash: 3; font-size: 18}}
}

title: "OpenAEV CI — Core & Nightly\n\nTwo triggers, one shared reusable workflow.\nRead top to bottom: it is a timeline." {
shape: text
style: {font-size: 34                                                                                                          ; bold: true}
}

title -> triggers: {style.opacity: 0}

# ═══ 1. Triggers ═════════════════════════════════════════════════════════════
triggers: "① WHEN IT LAUNCHES" {
direction: right
style: {fill: "#FFF8E1"; stroke: "#FF8F00"; stroke-width: 3 ; font-size: 24; bold: true}

core: "▶️  [Core] CI\n\npush → main, testing-xtm-one\npull_request → main\npush tag  N.N.N" {
style: {fill: "#FFE0B2"; stroke: "#E65100"; stroke-width: 3                                              ; border-radius: 20; bold: true; font-size: 21}
}
nightly: "🌙  [Core] Nightly CI\n\nschedule:  cron 0 3 * * *\n(daily, 03:00 UTC)\nworkflow_dispatch" {
style: {fill: "#FFE0B2"; stroke: "#E65100"; stroke-width: 3                                              ; border-radius: 20; bold: true; font-size: 21}
}
}

pipe: "⚙️  _ci-pipeline.yml\nshared reusable workflow  ·  secrets: inherit\n\nCore ≈ 36 jobs                Nightly ≈ 59 jobs" {
style: {fill: "#CFD8DC"; stroke: "#37474F"; stroke-width: 4                                                                               ; border-radius: 8; font-size: 24; bold: true}
}

triggers.core -> pipe: "api-matrix · e2e-matrix\nsnyk-fail-on-error: false" {class: needs}
triggers.nightly -> pipe: "larger matrices\nsnyk-fail-on-error: true" {class: needs}

# ═══ 2. Everything that starts immediately ═══════════════════════════════════
wave0: "② LAUNCHED IMMEDIATELY AT  t = 0   —   12 job definitions, not one `needs:` between them" {
direction: right
style: {fill: "#ECEFF1"; stroke: "#546E7A"; stroke-width: 4                                             ; font-size: 26; bold: true}

preflight: "PRE-FLIGHT" {
class: lane
mg: "🔎 Migrations Guard\n3 min cap\nnew migrations must be appended\nafter the last release tag" {class: preflight}
}

build: "BUILD" {
class: lane
bc: "🔨 Backend Compile\n10 min\n→ backend-compiled\n→ api-build-output" {class: build}
fb: "🎨 Frontend Build\n15 min · yarn build" {class: build}
pba: "📦 Prepare Bundled Assets\n10 min · JFrog agents + implants\ncatalog-integrators.json patch" {class: build}
}

quality: "STATIC QUALITY" {
class: lane
sc: "🔍 Spotless Check\n10 min · Java format" {class: quality}
fq: "🧪 Frontend Quality & Unit Tests\n20 min · ESLint + Vitest" {class: quality}
}

docker: "DOCKER" {
class: lane
db: "🐳 Docker Build  ×4\nstd / ubi9  ×  amd64 / arm64\n25 min · fail-fast: false\nbundled assets prepared inline" {class: docker}
dm: "🐳 Merge Platforms  ×2\n20 min · multi-arch OCI index" {class: docker}
snyk: "🔒 Snyk Container Scan\n25 min · threshold high\nCore ⚠️ advisory\nNightly ❌ blocking" {class: docker}
}

tests: "TESTS" {
class: lane
at: "🧪 API Tests\nCore 8 · Nightly 16 cells\n30 min · fail-fast: false" {class: test}
e2e: "🧪 E2E Tests (Playwright)\nCore 10 · Nightly 25 cells\n45 min · fail-fast: false" {class: test}
atc: "🔎 API Types Check\n20 min · generated TS types\nvs live API schema" {class: test}
}
}

pipe -> wave0: "starts all 12 at once" {class: launch}

# ═══ 3. The only jobs that actually wait ═════════════════════════════════════
gated: "③ THE ONLY JOBS THAT WAIT ON  needs:" {
direction: right
style: {fill: "#FFF3E0"; stroke: "#EF6C00"; stroke-width: 4 ; font-size: 24; bold: true}

bp: "📦 Backend Package (glibc)\n15 min → openaev-api-jar" {class: docker}
bpm: "📦 Backend Package (musl)\n15 min · maven alpine container" {class: docker}
}

wave0.build -> gated.bp: "needs: Backend Compile\n+ Frontend Build\n+ Prepare Bundled Assets" {class: needs}
wave0.build -> gated.bpm: "needs: same three" {class: needs}

# ═══ 4. Aggregation ══════════════════════════════════════════════════════════
cov: "📊 Coverage Merge & Upload\n15 min · JaCoCo shards + Vitest + Playwright → Codecov\nbest-effort, and deliberately NOT wired into the Gate" {
style: {fill: "#FCE4EC"; stroke: "#AD1457"; stroke-width: 3                                                                                             ; border-radius: 8; font-size: 21}
}

wave0.tests -> cov: "needs: API Tests, E2E, API Types Check" {class: needs}
wave0.quality -> cov: "needs: Frontend Quality" {class: needs}

gate: "✅   PIPELINE GATE\nrequired branch-protection status check\n\"pipeline / ✅ Pipeline Gate\"\n\nif: always()   ·   needs: 14 jobs   ·   Coverage excluded" {
style: {fill: "#FFCDD2"; stroke: "#B71C1C"; stroke-width: 5                                                                                                             ; border-radius: 8; font-size: 28; bold: true}
}

wave0 -> gate: "12 of the 14" {class: needs}
gated -> gate: "the other 2" {class: needs}

retry: "🔄 Auto-Retry Failed CI\n\nseparate workflow, on workflow_run: completed\nconclusion == failure  AND  run_attempt == 1\n→ POST rerun-failed-jobs on the same run\n\nLoops back to ② as attempt 2 — exactly once" {
style: {fill: "#EDE7F6"; stroke: "#4527A0"; stroke-width: 3                                                                                                                                                                        ; stroke-dash: 3; border-radius: 8; font-size: 21}
}

gate -> retry: "on failure" {class: loop}

# ═══ Polling waits — replace `needs:` wherever the payload matters ═══════════
wave0.build.bc -> wave0.tests.at: "POLLS artifact\napi-build-output\n120 × 5s = 10 min cap" {class: poll}
wave0.docker.db -> wave0.tests.e2e: "POLLS GHCR image\n(fallback: artifact)\n180 × 5s = 15 min cap" {class: poll}
wave0.docker.db -> wave0.docker.dm: "POLLS amd64 + arm64\n15 min each" {class: poll}
wave0.docker.db -> wave0.docker.snyk: "POLLS std + ubi9 amd64\n15 min each" {class: poll}
gated.bp -> wave0.tests.atc: "POLLS artifact openaev-api-jar · 180 × 5s = 15 min cap" {class: poll}

# Plain labels, not `|md` blocks: d2 renders markdown into <foreignObject>, which
# browsers refuse to draw when the SVG is embedded as an <img> (e.g. on GitHub).
legend: "LEGEND — HOW TO READ THE ARROWS\n\n▬▬▶   DARK SOLID   =   a real needs: in the YAML\nwaits for the entire upstream job to finish, artifact upload included\nthat is ~2.5 min of gzip / validate / upload the consumer never uses\nonly four edges in this whole pipeline are true needs:\n\n╍╍▶   ORANGE DASHED   =   polling wait, no needs: at all\nthe job starts at t = 0 and boots its service containers in parallel\n(Postgres, Elasticsearch or OpenSearch, RabbitMQ, MinIO)\nthen it loops on the GitHub API / GHCR until the payload appears\nand self-aborts the moment the upstream job reports failure or cancelled\nthis is the trick that keeps the critical path short\n\n╍╍▶   PURPLE DASHED   =   auto-retry, fires once, on attempt 1 only\n\nDOCKER BUILD HAS NO ARROW FROM PREPARE BUNDLED ASSETS\nit re-runs the asset preparation inline with upload-artifact: false\nsaving ~1.4 min at the head of the critical path" {
style: {fill: "#FFFFFF"; stroke: "#607D8B"; stroke-width: 3                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   ; font-size: 20}
}

matrix: "CORE vs NIGHTLY — THE ONLY THREE DIFFERENCES\n\nAPI TESTS\nCore: 8 cells — 7 balanced shards + a 'remaining' catch-all, Elasticsearch\nNightly: the same 8 run twice, on Elasticsearch AND OpenSearch\nshard patterns live in .github/shards/api-<n>.txt\n\nE2E TESTS\nCore: 10 cells, standard image only, chrome/amd64 + chromium/arm64\nsharded arsenals / multitenant / remaining, plus 4 infra cells\nNightly: 25 cells, std + ubi9, five browsers, amd64 + arm64\nplus the OpenSearch variants and 7 infra cells\n\nSNYK\nCore: reports findings, never blocks the Gate\nNightly: fails the Gate on high/critical findings and scanner errors" {
style: {fill: "#FFFFFF"; stroke: "#607D8B"; stroke-width: 3                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         ; font-size: 20}
}

# Invisible anchors: keep the prose blocks inside the layout flow instead of
# `near:`, which reserves a whole empty band on the canvas.
retry -> legend: {style.opacity: 0}
retry -> matrix: {style.opacity: 0}
