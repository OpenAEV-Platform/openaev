# Single source of truth for container image versions (local dev + CI).
#
# Local dev: loaded by docker-compose.yml. `.env` sets COMPOSE_ENV_FILES so that
#   `podman compose up -d` picks this file up without any extra flags. These are
#   the only image tags — docker-compose.yml declares no fallbacks.
# CI: sourced by the composite actions in .github/actions/.
#
# Renovate tracks this file with a custom regex manager (see renovate.json5).

POSTGRES_IMAGE=postgres:17-alpine
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.15
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.7.0
RABBITMQ_IMAGE=rabbitmq:4.3-management
MINIO_IMAGE=minio/minio:RELEASE.2025-06-13T11-33-47Z
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.19.15
OPENSSL_IMAGE=alpine/openssl:3.5.7
