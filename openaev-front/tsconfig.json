{
  "compilerOptions": {
    // we can target ESNext as Vite handles transpilation and browser compat
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  // the default "**/*" skips dot files
  "include": [
    "**/*",
    ".dependency-cruiser.ts"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "packages",
    "public",
    "builder/prod/build",
    "src/static/ext/*",
    "vite.config.ts",
    "__generated__",
    // imports the ESLint plugin, which packages/eslint-plugin-custom-rules/tsconfig.json checks
    "eslint.config.js"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}