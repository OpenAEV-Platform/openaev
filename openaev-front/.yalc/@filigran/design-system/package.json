{
  "name": "@filigran/design-system",
  "version": "0.1.0",
  "description": "AI-first design system for Filigran products",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./styles/gradient-helpers.css": "./dist/styles/gradient-helpers.css",
    "./tokens/theme.css": "./dist/tokens/theme.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i src/tokens/index.css -o dist/index.css --minify && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/tokens',{recursive:true}); fs.copyFileSync('src/tokens/theme.css','dist/tokens/theme.css'); fs.mkdirSync('dist/styles',{recursive:true}); fs.copyFileSync('src/styles/gradient-helpers.css','dist/styles/gradient-helpers.css');\"",
    "dev": "concurrently \"tsup --watch\" \"tailwindcss -i src/tokens/index.css -o dist/index.css --watch\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.18",
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.23.0",
    "tailwind-merge": "^3.3.1"
  },
  "yalcSig": "753b343cdd7ddb8315d274f9d123e924"
}
